# ============================================================
# OPPORTUNE V4 — Environment Variables Example
# ============================================================

# --- Server ---
PORT=8000
NODE_ENV=development
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# --- Database (PostgreSQL / Supabase) ---
# Replace with your Supabase direct connection string or local PostgreSQL:
# e.g., postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/opportune_v4
DATABASE_POOL_SIZE=10

# --- Redis Cache ---
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false
REDIS_CACHE_TTL_SECONDS=3600

# --- Supabase Auth & Storage ---
VITE_SUPABASE_URL=https://bamhgnsilycmlvzmvbth.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here
SUPABASE_URL=https://bamhgnsilycmlvzmvbth.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# --- Crawler & Scheduler ---
CRAWLER_CONCURRENCY=5
CRAWLER_PER_DOMAIN_DELAY_MS=1500
CRAWLER_CRON=0 0 * * *
CRAWLER_TIMEZONE=Asia/Kolkata
