# ============================================================
# OPPORTUNE V4 — Backend Environment Variables Example
# ============================================================

PORT=8000
NODE_ENV=development
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# --- Database (PostgreSQL / Supabase) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/opportune_v4
DATABASE_POOL_SIZE=10

# --- Redis Cache ---
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false
REDIS_CACHE_TTL_SECONDS=3600

# --- Supabase Auth & Storage ---
SUPABASE_URL=https://bamhgnsilycmlvzmvbth.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- Crawler & Scheduler ---
CRAWLER_CONCURRENCY=5
CRAWLER_PER_DOMAIN_DELAY_MS=1500
CRAWLER_CRON=0 0 * * *
CRAWLER_TIMEZONE=Asia/Kolkata
